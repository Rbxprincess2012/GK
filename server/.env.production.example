# Скопируй в .env.production на сервере и заполни секреты.
PORT=3000
NODE_ENV=production

# managed PostgreSQL (Timeweb)
PGHOST=ef67476a3eac0d3eda7a6172.twc1.net
PGPORT=5432
PGUSER=gen_user
PGPASSWORD=__ПАРОЛЬ_БД__
PGDATABASE=default_db
PGSSL=require

# Авторизация: ОБЯЗАТЕЛЬНО свой секрет.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=__СГЕНЕРИРУЙ_СЛУЧАЙНЫЙ__

# Сервисный токен для n8n (бот-ручки). Этот же токен вписать в n8n.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SERVICE_TOKEN=__СГЕНЕРИРУЙ_СЛУЧАЙНЫЙ__

# Домен(ы) фронта через запятую. Пока фронт локальный — можно оставить пустым (разрешит любой origin).
# CORS_ORIGIN=https://dispatcher.example.ru

# Бутстрап суперпользователя (для seed:superuser)
SUPERUSER_EMAIL=clockerinfo@gmail.com
SUPERUSER_PASSWORD=__СВОЙ_ПАРОЛЬ__
