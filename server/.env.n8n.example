# Конфиг n8n. Скопируй в server/.env.n8n на сервере и заполни. НЕ коммитить.
# Ключ шифрования сохранённых учёток/креденшелов n8n.
# Сгенерировать:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=__СГЕНЕРИРУЙ_СЛУЧАЙНЫЙ__

# Аккаунт-владелец n8n создаётся при первом входе в веб-интерфейс (логин/пароль),
# поэтому отдельный basic-auth здесь не нужен.
