PORT=3000
PGHOST=ef67476a3eac0d3eda7a6172.twc1.net
PGPORT=5432
PGUSER=gen_user
PGPASSWORD=your_password_here
PGDATABASE=default_db
PGSSL=require
NODE_ENV=development

# Токены ботов задаются в админке (Настройки → токены) и хранятся в БД.
# Эти переменные — ОПЦИОНАЛЬНЫЙ фолбэк (напр. для локалки), основной источник — Настройки.
# DRIVER_BOT_TOKEN=123456:your-driver-bot-token
# DRIVER_BOT_USERNAME=your_driver_bot   # без @; обычно не нужен — username берётся из getMe
# Каталог хранения медиа-пруфа (в проде — volume /app/media)
MEDIA_DIR=./media

# Базовый адрес для публичных ссылок: фотоотчёт клиенту /r/:token и ссылка входа в письмах.
# В проде ОБЯЗАТЕЛЬНО задать домен (без слэша на конце). Локально — http://localhost:3000.
APP_URL=https://putevo.su
