{
	# Контакт для Let's Encrypt (необязательно; уведомления об истечении).
	email admin@putevo.su
	# DNS-01 через Cloudflare: домен подтверждается TXT-записью, а не входящим
	# соединением к серверу (РФ режет inbound от валидаторов LE). Токен — в env
	# контейнера web (CF_API_TOKEN, см. docker-compose.prod.yml + /opt/dispatcher/.env).
	acme_dns cloudflare {env.CF_API_TOKEN}
}

# Основной домен: админка (/admin) + API (/api). Caddy сам выпускает и продлевает HTTPS.
putevo.su {
	encode zstd gzip

	# API → контейнер бэкенда
	handle /api/* {
		reverse_proxy api:3000
	}

	# Админка: статика собранного фронта (Vite base = /admin/)
	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# Корень и всё остальное → в админку
	handle {
		redir /admin/ 302
	}
}

# n8n на отдельном поддомене (сюда Telegram шлёт webhook).
n8n.putevo.su {
	encode zstd gzip
	reverse_proxy n8n:5678
}
