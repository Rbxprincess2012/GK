# Сайт работает ЗА Cloudflare (оранжевое облако, режим SSL = Flexible).
# Почему так: прямой HTTPS (443) к РФ-IP этого сервера режется на сетевом уровне
# (DPI/ТСПУ рвёт TLS-handshake — и изнутри РФ, и из-за рубежа), а порт 80 ходит
# стабильно. Поэтому TLS терминируется на чистых IP Cloudflare, а до origin
# Cloudflare ходит по HTTP:80. Свой ACME/HTTPS на сервере отключаем — он не нужен
# и всё равно не доходит до клиентов.
{
	auto_https off
}

# Общие настройки для всех сайтов.
(common) {
	encode zstd gzip
}

# Основной домен: админка (/admin) + API (/api). Только HTTP — TLS делает Cloudflare.
http://putevo.su, http://www.putevo.su {
	import common

	# API → контейнер бэкенда
	handle /api/* {
		reverse_proxy api:3000
	}

	# Админка: статика собранного фронта (Vite base = /admin/)
	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	# Корень и всё остальное → в админку
	handle {
		redir /admin/ 302
	}
}

# n8n на отдельном поддомене (сюда Telegram шлёт webhook). Тоже за Cloudflare по HTTP.
http://n8n.putevo.su {
	import common
	reverse_proxy n8n:5678
}
