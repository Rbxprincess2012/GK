{
	# Контакт для Let's Encrypt (необязательно; уведомления об истечении).
	email admin@putevo.su
	# DNS-01 через Timeweb: домен подтверждается TXT-записью, а не входящим
	# соединением к серверу (РФ режет inbound от валидаторов LE). DNS хостится в
	# Timeweb, NS/NIC не трогаем. Токен — в env контейнера web (TW_TOKEN, JWT из
	# timeweb.cloud/my/api-keys; см. docker-compose.prod.yml + /opt/dispatcher/.env).
	acme_dns timeweb {env.TW_TOKEN}
}

# Основной домен: публичная витрина + рабочее пространство SPA на корне + API.
# Caddy сам выпускает и продлевает HTTPS.
putevo.su {
	encode zstd gzip

	# API → контейнер бэкенда
	handle /api/* {
		reverse_proxy api:3000
	}

	# Публичный фотоотчёт клиенту (бэкенд рендерит HTML страницы /r/:token)
	handle /r/* {
		reverse_proxy api:3000
	}

	# Медиа-пруфы (фото/видео/голос) — бэкенд отдаёт их из своего хранилища.
	# На них ссылается публичный отчёт и карточки в админке.
	handle /media/* {
		reverse_proxy api:3000
	}

	# Совместимость: старые ссылки /admin/... (закладки, ранее отправленные
	# письма-приглашения) → тот же путь на корне, с сохранением query/токена.
	# handle_path срезает префикс /admin ДО внутренних директив, поэтому {uri}
	# здесь уже без /admin (иначе redir зациклится сам на себя).
	handle_path /admin/* {
		redir {uri} 302
	}

	# Корень = SPA: витрина для гостя + рабочее пространство для сотрудника.
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

# n8n на отдельном поддомене (сюда Telegram шлёт webhook).
n8n.putevo.su {
	encode zstd gzip
	reverse_proxy n8n:5678
}
