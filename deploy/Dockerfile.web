# Многоступенчатая сборка: фронт (админка) → Caddy с авто-HTTPS (reverse proxy + статика).
# Контекст сборки — корень репозитория (см. docker-compose.prod.yml).

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Прод-адрес API зашивается в сборку фронта.
ARG VITE_API_URL=https://putevo.su/api
RUN printf 'VITE_API_URL=%s\n' "$VITE_API_URL" > .env.production && npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv/admin
