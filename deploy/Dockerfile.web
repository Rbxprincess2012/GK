# Сборка фронта (админки) поверх готового образа Caddy (dispatcher-caddy:local).
# Caddy с DNS-плагином собирается ОТДЕЛЬНО (deploy/Dockerfile.caddy) и здесь НЕ
# компилируется — поэтому обычный деплой занимает секунды, а не минуты.
# Контекст сборки — корень репозитория (см. docker-compose.prod.yml).

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
# РФ→registry.npmjs.org таймаутит — ставим через зеркало, доступное из РФ, + ретраи.
RUN npm ci --no-audit --no-fund \
    --registry=https://registry.npmmirror.com \
    --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-timeout=600000
COPY . .
# Прод-адрес API зашивается в сборку фронта.
ARG VITE_API_URL=https://putevo.su/api
RUN printf 'VITE_API_URL=%s\n' "$VITE_API_URL" > .env.production && npm run build

# Базовый образ — заранее собранный Caddy с плагином (deploy/Dockerfile.caddy).
FROM dispatcher-caddy:local
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv/admin
