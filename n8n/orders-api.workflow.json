{
  "name": "Orders API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "orders",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "http://localhost:5174" }
      },
      "id": "wh-list",
      "name": "GET /orders",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "orders-list"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM orders ORDER BY number DESC;",
        "options": {}
      },
      "id": "db-list",
      "name": "DB: list orders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [240, 0],
      "credentials": { "postgres": { "id": "REPLACE_ME", "name": "Postgres - tatyana" } }
    },
    {
      "parameters": { "respondWith": "allIncomingItems", "options": {} },
      "id": "resp-list",
      "name": "Respond list",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 0]
    },

    {
      "parameters": {
        "httpMethod": "GET",
        "path": "orders/:id",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "http://localhost:5174" }
      },
      "id": "wh-one",
      "name": "GET /orders/:id",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 200],
      "webhookId": "orders-one"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM orders WHERE id = $1;",
        "options": { "queryReplacement": "={{ [$json.params.id] }}" }
      },
      "id": "db-one",
      "name": "DB: get order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [240, 200],
      "credentials": { "postgres": { "id": "REPLACE_ME", "name": "Postgres - tatyana" } }
    },
    {
      "parameters": { "respondWith": "firstIncomingItem", "options": {} },
      "id": "resp-one",
      "name": "Respond one",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 200]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orders",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "http://localhost:5174" }
      },
      "id": "wh-create",
      "name": "POST /orders",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 420],
      "webhookId": "orders-create"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO orders (client_id, driver_id, items, status, note)\nVALUES ($1, $2, $3::jsonb, 'new', $4)\nRETURNING *;",
        "options": { "queryReplacement": "={{ [$json.body.client_id || null, $json.body.driver_id || null, JSON.stringify($json.body.items || []), $json.body.note || null] }}" }
      },
      "id": "db-create",
      "name": "DB: create order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [240, 420],
      "credentials": { "postgres": { "id": "REPLACE_ME", "name": "Postgres - tatyana" } }
    },
    {
      "parameters": { "respondWith": "firstIncomingItem", "options": {} },
      "id": "resp-create",
      "name": "Respond created",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 380]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_CHAT_ID",
        "text": "=🆕 Новый заказ №{{ $json.number }} (id {{ $json.id }}), точек: {{ ($json.items || []).length }}",
        "additionalFields": {}
      },
      "id": "tg-new",
      "name": "Telegram: new order",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, 560],
      "credentials": { "telegramApi": { "id": "REPLACE_ME", "name": "Telegram bot" } }
    },

    {
      "parameters": {
        "httpMethod": "PATCH",
        "path": "orders/:id",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "http://localhost:5174" }
      },
      "id": "wh-update",
      "name": "PATCH /orders/:id",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 760],
      "webhookId": "orders-update"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE orders\nSET status    = COALESCE($2, status),\n    driver_id = COALESCE($3, driver_id)\nWHERE id = $1\nRETURNING *;",
        "options": { "queryReplacement": "={{ [$json.params.id, $json.body.status || null, $json.body.driver_id || null] }}" }
      },
      "id": "db-update",
      "name": "DB: update order",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [240, 760],
      "credentials": { "postgres": { "id": "REPLACE_ME", "name": "Postgres - tatyana" } }
    },
    {
      "parameters": { "respondWith": "firstIncomingItem", "options": {} },
      "id": "resp-update",
      "name": "Respond updated",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 760]
    }
  ],
  "connections": {
    "GET /orders":       { "main": [[{ "node": "DB: list orders",  "type": "main", "index": 0 }]] },
    "DB: list orders":   { "main": [[{ "node": "Respond list",     "type": "main", "index": 0 }]] },

    "GET /orders/:id":   { "main": [[{ "node": "DB: get order",    "type": "main", "index": 0 }]] },
    "DB: get order":     { "main": [[{ "node": "Respond one",      "type": "main", "index": 0 }]] },

    "POST /orders":      { "main": [[{ "node": "DB: create order", "type": "main", "index": 0 }]] },
    "DB: create order":  { "main": [[
        { "node": "Respond created",     "type": "main", "index": 0 },
        { "node": "Telegram: new order", "type": "main", "index": 0 }
    ]] },

    "PATCH /orders/:id": { "main": [[{ "node": "DB: update order", "type": "main", "index": 0 }]] },
    "DB: update order":  { "main": [[{ "node": "Respond updated",  "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
